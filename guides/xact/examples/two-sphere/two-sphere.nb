Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"DefManifold", "[", 
   RowBox[{"M", ",", " ", "2", ",", " ", 
    RowBox[{"{", 
     RowBox[{"a", ",", "b", ",", "c", ",", "d", ",", "e", ",", "f"}], "}"}]}],
    "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"DefChart", "[", 
   RowBox[{"ch", ",", " ", "M", ",", " ", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2"}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"theta", "[", "]"}], ",", 
      RowBox[{"phi", "[", "]"}]}], "}"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"DefConstantSymbol", "[", "radius", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"DefMetric", "[", 
   RowBox[{"1", ",", " ", 
    RowBox[{"g", "[", 
     RowBox[{
      RowBox[{"-", "a"}], ",", 
      RowBox[{"-", "b"}]}], "]"}], ",", " ", "CD", ",", " ", 
    RowBox[{"{", 
     RowBox[{"\"\<;\>\"", ",", "\"\<D\>\""}], "}"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"$Assumptions", " ", "=", " ", 
   RowBox[{
    RowBox[{"radius", ">", "0"}], " ", "&&", " ", 
    RowBox[{"0", "<", 
     RowBox[{"theta", "[", "]"}], "<", "Pi"}], " ", "&&", " ", 
    RowBox[{"Element", "[", 
     RowBox[{
      RowBox[{"phi", "[", "]"}], ",", "Reals"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"metricMatrix", "=", 
   RowBox[{"DiagonalMatrix", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"radius", "^", "2"}], ",", 
      RowBox[{
       RowBox[{"radius", "^", "2"}], " ", 
       RowBox[{
        RowBox[{"Sin", "[", 
         RowBox[{"theta", "[", "]"}], "]"}], "^", "2"}]}]}], "}"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"MetricInBasis", "[", 
   RowBox[{"g", ",", 
    RowBox[{"-", "ch"}], ",", "metricMatrix"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"MetricCompute", "[", 
   RowBox[{"g", ",", "ch", ",", "All", ",", 
    RowBox[{"CVSimplify", "->", "Simplify"}], ",", 
    RowBox[{"Verbose", "->", "True"}]}], "]"}], ";"}]}], "Input",
 CellLabel->"In[2]:=",ExpressionUUID->"9729d095-fc04-3340-ba30-924688cb703e"],

