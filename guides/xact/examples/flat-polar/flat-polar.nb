     RowBox[{"\"\<Gamma_phi_rphi\>\"", "->", 
      RowBox[{"TrueQ", "[", 
       RowBox[{"Simplify", "[", 
        RowBox[{
         RowBox[{"connection", "[", 
          RowBox[{"[", 
           RowBox[{"2", ",", "1", ",", "2"}], "]"}], "]"}], "==", 
         RowBox[{"1", "/", 
          RowBox[{"r", "[", "]"}]}]}], "]"}], "]"}]}], ",", 
     RowBox[{"\"\<RiemannZero\>\"", "->", 
