Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"DefManifold", "[", 
   RowBox[{"M", ",", "5", ",", 
    RowBox[{"{", 
     RowBox[{
     "a", ",", "b", ",", "c", ",", "d", ",", "e", ",", "f", ",", "h"}], 
     "}"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"DefChart", "[", 
   RowBox[{"ch", ",", "M", ",", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2", ",", "3", ",", "4", ",", "5"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"t", "[", "]"}], ",", 
      RowBox[{"r", "[", "]"}], ",", 
      RowBox[{"chi", "[", "]"}], ",", 
      RowBox[{"theta", "[", "]"}], ",", 
      RowBox[{"phi", "[", "]"}]}], "}"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"DefConstantSymbol", "[", "radius", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"DefMetric", "[", 
   RowBox[{
    RowBox[{"-", "1"}], ",", 
    RowBox[{"g", "[", 
     RowBox[{
      RowBox[{"-", "a"}], ",", 
      RowBox[{"-", "b"}]}], "]"}], ",", "CD", ",", 
    RowBox[{"{", 
     RowBox[{"\"\<;\>\"", ",", "\"\<D\>\""}], "}"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"$Assumptions", "=", 
   RowBox[{
    RowBox[{"radius", ">", "0"}], " ", "&&", " ", 
    RowBox[{
     RowBox[{"r", "[", "]"}], ">", "0"}], " ", "&&", " ", 
    RowBox[{"0", "<", 
     RowBox[{"chi", "[", "]"}], "<", "Pi"}], " ", "&&", " ", 
    RowBox[{"0", "<", 
     RowBox[{"theta", "[", "]"}], "<", "Pi"}], " ", "&&", " ", 
    RowBox[{"Element", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"t", "[", "]"}], ",", 
        RowBox[{"phi", "[", "]"}]}], "}"}], ",", "Reals"}], "]"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"metricMatrix", "=", 
   RowBox[{"DiagonalMatrix", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{
          RowBox[{
           RowBox[{"r", "[", "]"}], "^", "2"}], "/", 
          RowBox[{"radius", "^", "2"}]}]}], ")"}]}], ",", 
      RowBox[{"1", "/", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{
          RowBox[{
           RowBox[{"r", "[", "]"}], "^", "2"}], "/", 
          RowBox[{"radius", "^", "2"}]}]}], ")"}]}], ",", 
      RowBox[{
       RowBox[{"r", "[", "]"}], "^", "2"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"r", "[", "]"}], "^", "2"}], " ", 
       RowBox[{
        RowBox[{"Sin", "[", 
         RowBox[{"chi", "[", "]"}], "]"}], "^", "2"}]}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"r", "[", "]"}], "^", "2"}], " ", 
       RowBox[{
        RowBox[{"Sin", "[", 
         RowBox[{"chi", "[", "]"}], "]"}], "^", "2"}], " ", 
       RowBox[{
        RowBox[{"Sin", "[", 
         RowBox[{"theta", "[", "]"}], "]"}], "^", "2"}]}]}], "}"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"MetricInBasis", "[", 
   RowBox[{"g", ",", 
    RowBox[{"-", "ch"}], ",", "metricMatrix"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"MetricCompute", "[", 
   RowBox[{"g", ",", "ch", ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<Riemann\>\"", "[", 
       RowBox[{
        RowBox[{"-", "1"}], ",", 
        RowBox[{"-", "1"}], ",", 
        RowBox[{"-", "1"}], ",", 
        RowBox[{"-", "1"}]}], "]"}], ",", 
      RowBox[{"\"\<Ricci\>\"", "[", 
       RowBox[{
        RowBox[{"-", "1"}], ",", 
        RowBox[{"-", "1"}]}], "]"}], ",", 
      RowBox[{"\"\<RicciScalar\>\"", "[", "]"}], ",", 
      RowBox[{"\"\<Einstein\>\"", "[", 
       RowBox[{
        RowBox[{"-", "1"}], ",", 
        RowBox[{"-", "1"}]}], "]"}], ",", 
      RowBox[{"\"\<Kretschmann\>\"", "[", "]"}]}], "}"}], ",", 
    RowBox[{"CVSimplify", "->", "Simplify"}]}], "]"}], ";"}]}], "Input",
 CellLabel->"In[2]:=",ExpressionUUID->"c2556fcb-929d-5a4d-a72e-b2db60c840ae"],

