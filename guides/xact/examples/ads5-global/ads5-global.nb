Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"expectedRiemann", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"metricMatrix", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "k"}], "]"}], "]"}], " ", 
          RowBox[{"metricMatrix", "[", 
           RowBox[{"[", 
            RowBox[{"j", ",", "l"}], "]"}], "]"}]}], "-", 
         RowBox[{
          RowBox[{"metricMatrix", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "l"}], "]"}], "]"}], " ", 
          RowBox[{"metricMatrix", "[", 
           RowBox[{"[", 
            RowBox[{"j", ",", "k"}], "]"}], "]"}]}]}], ")"}]}], "/", 
      RowBox[{"radius", "^", "2"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "5"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "5"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "5"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"l", ",", "5"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"checks", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<Riemann\>\"", "->", 
      RowBox[{"TrueQ", "[", 
       RowBox[{"Simplify", "[", 
        RowBox[{"curvature", "==", "expectedRiemann"}], "]"}], "]"}]}], ",", 
     RowBox[{"\"\<Ricci\>\"", "->", 
      RowBox[{"TrueQ", "[", 
       RowBox[{"Simplify", "[", 
        RowBox[{"ricci", "==", 
         RowBox[{
          RowBox[{"-", "4"}], 
          RowBox[{"metricMatrix", "/", 
           RowBox[{"radius", "^", "2"}]}]}]}], "]"}], "]"}]}], ",", 
     RowBox[{"\"\<Scalar\>\"", "->", 
      RowBox[{"TrueQ", "[", 
       RowBox[{"Simplify", "[", 
        RowBox[{"scalar", "==", 
         RowBox[{
          RowBox[{"-", "20"}], "/", 
          RowBox[{"radius", "^", "2"}]}]}], "]"}], "]"}]}], ",", 
     RowBox[{"\"\<Kretschmann\>\"", "->", 
      RowBox[{"TrueQ", "[", 
       RowBox[{"Simplify", "[", 
        RowBox[{"kretschmann", "==", 
         RowBox[{"40", "/", 
          RowBox[{"radius", "^", "4"}]}]}], "]"}], "]"}]}], ",", 
     RowBox[{"\"\<VacuumLambda\>\"", "->", 
      RowBox[{"TrueQ", "[", 
       RowBox[{"Simplify", "[", 
        RowBox[{
         RowBox[{"einstein", "-", 
          RowBox[{"6", 
           RowBox[{"metricMatrix", "/", 
            RowBox[{"radius", "^", "2"}]}]}]}], "==", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{"0", ",", 
           RowBox[{"{", 
            RowBox[{"5", ",", "5"}], "}"}]}], "]"}]}], "]"}], "]"}]}]}], 
    "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"allChecksPassed", "=", 
   RowBox[{"And", "@@", 
    RowBox[{"Values", "[", "checks", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"caseResults", "=", 
   RowBox[{"<|", 
