Cell[BoxData[{
 RowBox[{
  RowBox[{"checks", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<Gamma_r_phiphi\>\"", "->", 
      RowBox[{"TrueQ", "[", 
       RowBox[{"Simplify", "[", 
        RowBox[{
         RowBox[{"connection", "[", 
          RowBox[{"[", 
           RowBox[{"1", ",", "2", ",", "2"}], "]"}], "]"}], "==", 
         RowBox[{"-", 
