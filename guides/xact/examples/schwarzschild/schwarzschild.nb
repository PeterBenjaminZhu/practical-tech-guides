Cell[CellGroupData[{

Cell["\:5b8c\:6574 geodesic equations", "Section",ExpressionUUID->"ca79f5f8-75c8-a44d-94d8-0bcb017326c0"],

Cell["\<\
geodesic \:5217\:8868\:4f9d\:6b21\:7ed9\:51fa t\:3001r\:3001theta\:3001phi \
\:65b9\:7a0b\:5de6\:4fa7\:ff0c\:5404\:81ea\:7b49\:4e8e\:96f6\:3002\:76f4\:63a5\
\:4f7f\:7528 xCoba \:7684 connection components\:3002\:65cb\:8f6c\:5bf9\:79f0\
\:6027\:5141\:8bb8\:9009\:53d6 equatorial plane theta=Pi/2\:3002\:968f\:540e\
\:6838\:5bf9\:80fd\:91cf energy=(1-2mass/r) dt/ds \:548c\:89d2\:52a8\:91cf \
angularMomentum=r^2 dphi/ds \:7684\:5b88\:6052\:3002\
\>", "Text",ExpressionUUID->"6508549d-83ef-9d40-8afb-d97bf4cba41f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"coordinates", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"t", "[", "]"}], ",", 
     RowBox[{"r", "[", "]"}], ",", 
     RowBox[{"theta", "[", "]"}], ",", 
     RowBox[{"phi", "[", "]"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"coordinateFunctions", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"time", "[", "s", "]"}], ",", 
     RowBox[{"radial", "[", "s", "]"}], ",", 
     RowBox[{"polar", "[", "s", "]"}], ",", 
     RowBox[{"azimuth", "[", "s", "]"}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"geodesic", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{
         RowBox[{"coordinateFunctions", "[", 
          RowBox[{"[", "i", "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"s", ",", "2"}], "}"}]}], "]"}], "+", 
       RowBox[{"Sum", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"connection", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "j", ",", "k"}], "]"}], "]"}], "/.", 
            RowBox[{"Thread", "[", 
             RowBox[{"coordinates", "->", "coordinateFunctions"}], "]"}]}], 
           ")"}], " ", 
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"coordinateFunctions", "[", 
             RowBox[{"[", "j", "]"}], "]"}], ",", "s"}], "]"}], " ", 
          RowBox[{"D", "[", 
           RowBox[{
            RowBox[{"coordinateFunctions", "[", 
             RowBox[{"[", "k", "]"}], "]"}], ",", "s"}], "]"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"j", ",", "4"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "4"}], "}"}]}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "4"}], "}"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"equatorial", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{"geodesic", "/.", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"polar", "[", "s", "]"}], "->", 
        RowBox[{"Pi", "/", "2"}]}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"polar", "'"}], "[", "s", "]"}], "->", "0"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"polar", "''"}], "[", "s", "]"}], "->", "0"}]}], "}"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"energyExpression", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"1", "-", 
      RowBox[{"2", 
       RowBox[{"mass", "/", 
        RowBox[{"radial", "[", "s", "]"}]}]}]}], ")"}], " ", 
    RowBox[{
     RowBox[{"time", "'"}], "[", "s", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"angularMomentumExpression", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"radial", "[", "s", "]"}], "^", "2"}], " ", 
    RowBox[{
     RowBox[{"azimuth", "'"}], "[", "s", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"energyResidual", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{"energyExpression", ",", "s"}], "]"}], "-", 
     RowBox[{
      RowBox[{"(", 
