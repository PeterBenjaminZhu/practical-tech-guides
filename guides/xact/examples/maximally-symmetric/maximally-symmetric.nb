Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"checks", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<Ricci\>\"", "->", 
      RowBox[{"TrueQ", "[", 
       RowBox[{
        RowBox[{"ToCanonical", "[", 
         RowBox[{"ricci", "-", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"dimension", "-", "1"}], ")"}], "curvature", " ", 
           RowBox[{"g", "[", 
            RowBox[{
             RowBox[{"-", "b"}], ",", 
             RowBox[{"-", "d"}]}], "]"}]}]}], "]"}], "==", "0"}], "]"}]}], ",", 
     RowBox[{"\"\<Scalar\>\"", "->", 
      RowBox[{"TrueQ", "[", 
       RowBox[{"Simplify", "[", 
        RowBox[{"scalar", "==", 
         RowBox[{"dimension", " ", 
          RowBox[{"(", 
           RowBox[{"dimension", "-", "1"}], ")"}], "curvature"}]}], "]"}], 
       "]"}]}], ",", 
     RowBox[{"\"\<Kretschmann\>\"", "->", 
      RowBox[{"TrueQ", "[", 
       RowBox[{"Simplify", "[", 
        RowBox[{"kretschmann", "==", 
         RowBox[{"2", "dimension", " ", 
          RowBox[{"(", 
           RowBox[{"dimension", "-", "1"}], ")"}], 
          RowBox[{"curvature", "^", "2"}]}]}], "]"}], "]"}]}], ",", 
     RowBox[{"\"\<VacuumLambda\>\"", "->", 
      RowBox[{"TrueQ", "[", 
       RowBox[{
        RowBox[{"ToCanonical", "[", 
         RowBox[{"einstein", "+", 
          RowBox[{"cosmologicalConstant", " ", 
           RowBox[{"g", "[", 
            RowBox[{
             RowBox[{"-", "b"}], ",", 
             RowBox[{"-", "d"}]}], "]"}]}]}], "]"}], "==", "0"}], "]"}]}]}], 
    "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"allChecksPassed", "=", 
   RowBox[{"And", "@@", 
    RowBox[{"Values", "[", "checks", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"caseResults", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<case\>\"", "->", "\"\<maximally-symmetric\>\""}], ",", 
     RowBox[{"\"\<checks\>\"", "->", "checks"}], ",", 
     RowBox[{"\"\<ricci\>\"", "->", 
      RowBox[{"ToString", "[", 
       RowBox[{"ricci", ",", "InputForm"}], "]"}]}], ",", 
     RowBox[{"\"\<scalar\>\"", "->", 
      RowBox[{"ToString", "[", 
       RowBox[{"scalar", ",", "InputForm"}], "]"}]}], ",", 
