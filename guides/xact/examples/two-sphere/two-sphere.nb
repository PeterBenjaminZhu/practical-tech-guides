Cell["\<\
xTensor \:7684 RiemannCD[-a,-b,-c,d] \:5bf9\:5e94\:4f5c\:7528\:4e8e covector \
\:7684 commutator \
\:7cfb\:6570\:3002\:6b64\:5904\:8bb0\:5f55\:4e00\:4e2a\:5b9e\:9645\:5206\:91cf\
\:ff0c\:540c\:65f6\:7528 Ricci \:548c scalar \:56fa\:5b9a\:66f2\:7387\:7b26\
\:53f7\:ff1bCarroll \:7684 R^d{}_{cab} \:4e0e\:8be5\:987a\:5e8f\:76f8\:5dee\
\:8d1f\:53f7\:3002\
\>", "Text",ExpressionUUID->"dc5a5b53-882e-654c-8f9f-5200585a6b7e"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"checks", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<Ricci\>\"", "->", 
      RowBox[{"TrueQ", "[", 
       RowBox[{"Simplify", "[", 
        RowBox[{"ricci", "==", 
         RowBox[{"metricMatrix", "/", 
          RowBox[{"radius", "^", "2"}]}]}], "]"}], "]"}]}], ",", 
     RowBox[{"\"\<Scalar\>\"", "->", 
      RowBox[{"TrueQ", "[", 
       RowBox[{"Simplify", "[", 
        RowBox[{"scalar", "==", 
         RowBox[{"2", "/", 
          RowBox[{"radius", "^", "2"}]}]}], "]"}], "]"}]}]}], "|>"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"allChecksPassed", "=", 
   RowBox[{"And", "@@", 
    RowBox[{"Values", "[", "checks", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"caseResults", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<case\>\"", "->", "\"\<two-sphere\>\""}], ",", 
     RowBox[{"\"\<checks\>\"", "->", "checks"}], ",", 
     RowBox[{"\"\<ricci\>\"", "->", 
      RowBox[{"ToString", "[", 
       RowBox[{"ricci", ",", "InputForm"}], "]"}]}], ",", 
     RowBox[{"\"\<scalar\>\"", "->", 
      RowBox[{"ToString", "[", 
       RowBox[{"scalar", ",", "InputForm"}], "]"}]}], ",", 
     RowBox[{"\"\<riemannSample\>\"", "->", 
      RowBox[{"ToString", "[", 
       RowBox[{"riemannSample", ",", "InputForm"}], "]"}]}]}], "|>"}]}], 
  ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{"checks", ",", "allChecksPassed"}], "}"}]}], "Input",
 CellLabel->"In[14]:=",ExpressionUUID->"ee22b45a-c205-b345-8bd0-2a905b6a9c39"],

