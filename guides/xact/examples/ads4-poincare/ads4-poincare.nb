Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"expectedRiemann", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"metricMatrix", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "k"}], "]"}], "]"}], " ", 
          RowBox[{"metricMatrix", "[", 
           RowBox[{"[", 
            RowBox[{"j", ",", "l"}], "]"}], "]"}]}], "-", 
         RowBox[{
          RowBox[{"metricMatrix", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "l"}], "]"}], "]"}], " ", 
          RowBox[{"metricMatrix", "[", 
           RowBox[{"[", 
            RowBox[{"j", ",", "k"}], "]"}], "]"}]}]}], ")"}]}], "/", 
      RowBox[{"radius", "^", "2"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "4"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "4"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "4"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"l", ",", "4"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"checks", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<Riemann\>\"", "->", 
      RowBox[{"TrueQ", "[", 
       RowBox[{"Simplify", "[", 
        RowBox[{"curvature", "==", "expectedRiemann"}], "]"}], "]"}]}], ",", 
     RowBox[{"\"\<Ricci\>\"", "->", 
      RowBox[{"TrueQ", "[", 
       RowBox[{"Simplify", "[", 
        RowBox[{"ricci", "==", 
         RowBox[{
          RowBox[{"-", "3"}], 
          RowBox[{"metricMatrix", "/", 
           RowBox[{"radius", "^", "2"}]}]}]}], "]"}], "]"}]}], ",", 
     RowBox[{"\"\<Scalar\>\"", "->", 
      RowBox[{"TrueQ", "[", 
       RowBox[{"Simplify", "[", 
        RowBox[{"scalar", "==", 
         RowBox[{
          RowBox[{"-", "12"}], "/", 
          RowBox[{"radius", "^", "2"}]}]}], "]"}], "]"}]}], ",", 
     RowBox[{"\"\<Kretschmann\>\"", "->", 
      RowBox[{"TrueQ", "[", 
       RowBox[{"Simplify", "[", 
        RowBox[{"kretschmann", "==", 
         RowBox[{"24", "/", 
          RowBox[{"radius", "^", "4"}]}]}], "]"}], "]"}]}], ",", 
     RowBox[{"\"\<VacuumLambda\>\"", "->", 
      RowBox[{"TrueQ", "[", 
       RowBox[{"Simplify", "[", 
        RowBox[{
         RowBox[{"einstein", "-", 
          RowBox[{"3", 
           RowBox[{"metricMatrix", "/", 
            RowBox[{"radius", "^", "2"}]}]}]}], "==", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{"0", ",", 
           RowBox[{"{", 
            RowBox[{"4", ",", "4"}], "}"}]}], "]"}]}], "]"}], "]"}]}]}], 
    "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"allChecksPassed", "=", 
   RowBox[{"And", "@@", 
    RowBox[{"Values", "[", "checks", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"caseResults", "=", 
