      RowBox[{"ToString", "[", 
       RowBox[{"kretschmann", ",", "InputForm"}], "]"}]}], ",", 
     RowBox[{"\"\<lambda\>\"", "->", 
      RowBox[{"ToString", "[", 
       RowBox[{"cosmologicalConstant", ",", "InputForm"}], "]"}]}]}], 
    "|>"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{"checks", ",", "allChecksPassed"}], "}"}]}], "Input",
 CellLabel->"In[15]:=",ExpressionUUID->"72c576c6-df45-1e41-99bc-516ed964964c"],

