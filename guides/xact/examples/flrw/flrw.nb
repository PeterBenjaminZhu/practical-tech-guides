Cell["\:89e3\:6790\:68c0\:67e5", "Section",ExpressionUUID->"184edacb-46a5-824c-aa59-d7e76ffc9ea8"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"checks", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<FourVelocity\>\"", "->", 
      RowBox[{"TrueQ", "[", 
       RowBox[{"Simplify", "[", 
        RowBox[{
         RowBox[{"fourVelocity", ".", "metricMatrix", ".", "fourVelocity"}], "==", 
         RowBox[{"-", "1"}]}], "]"}], "]"}]}], ",", 
     RowBox[{"\"\<PerfectFluid\>\"", "->", 
      RowBox[{"TrueQ", "[", 
       RowBox[{"Simplify", "[", 
        RowBox[{"matter", "==", 
         RowBox[{"DiagonalMatrix", "[", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"rho", "[", 
             RowBox[{"t", "[", "]"}], "]"}], ",", 
            RowBox[{
             RowBox[{"pressure", "[", 
              RowBox[{"t", "[", "]"}], "]"}], " ", 
             RowBox[{"metricMatrix", "[", 
              RowBox[{"[", 
               RowBox[{"2", ",", "2"}], "]"}], "]"}]}], ",", 
            RowBox[{
             RowBox[{"pressure", "[", 
              RowBox[{"t", "[", "]"}], "]"}], " ", 
             RowBox[{"metricMatrix", "[", 
              RowBox[{"[", 
               RowBox[{"3", ",", "3"}], "]"}], "]"}]}], ",", 
            RowBox[{
             RowBox[{"pressure", "[", 
              RowBox[{"t", "[", "]"}], "]"}], " ", 
             RowBox[{"metricMatrix", "[", 
              RowBox[{"[", 
               RowBox[{"4", ",", "4"}], "]"}], "]"}]}]}], "}"}], "]"}]}], 
        "]"}], "]"}]}], ",", 
     RowBox[{"\"\<Scalar\>\"", "->", 
      RowBox[{"TrueQ", "[", 
       RowBox[{"Simplify", "[", 
        RowBox[{"scalar", "==", 
         RowBox[{"6", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"aScale", "''"}], "[", 
              RowBox[{"t", "[", "]"}], "]"}], "/", 
             RowBox[{"aScale", "[", 
              RowBox[{"t", "[", "]"}], "]"}]}], "+", 
            RowBox[{
             RowBox[{
              RowBox[{
               RowBox[{"aScale", "'"}], "[", 
               RowBox[{"t", "[", "]"}], "]"}], "^", "2"}], "/", 
             RowBox[{
              RowBox[{"aScale", "[", 
               RowBox[{"t", "[", "]"}], "]"}], "^", "2"}]}], "+", 
            RowBox[{"k", "/", 
             RowBox[{
              RowBox[{"aScale", "[", 
               RowBox[{"t", "[", "]"}], "]"}], "^", "2"}]}]}], ")"}]}]}], 
        "]"}], "]"}]}], ",", 
     RowBox[{"\"\<FriedmannDensity\>\"", "->", 
      RowBox[{"TrueQ", "[", 
       RowBox[{"Simplify", "[", 
        RowBox[{"densityResidual", "==", "expectedDensity"}], "]"}], "]"}]}], 
     ",", 
     RowBox[{"\"\<FriedmannPressure\>\"", "->", 
      RowBox[{"TrueQ", "[", 
       RowBox[{"Simplify", "[", 
        RowBox[{"pressureResidual", "==", "expectedPressure"}], "]"}], 
       "]"}]}], ",", 
     RowBox[{"\"\<SpatialIsotropy\>\"", "->", 
      RowBox[{"TrueQ", "[", 
       RowBox[{"Simplify", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"fieldEquations", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "i"}], "]"}], "]"}], "/", 
            RowBox[{"metricMatrix", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "i"}], "]"}], "]"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"i", ",", "2", ",", "4"}], "}"}]}], "]"}], "==", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{"pressureResidual", ",", "3"}], "]"}]}], "]"}], "]"}]}], ",", 
     RowBox[{"\"\<Continuity\>\"", "->", 
      RowBox[{"TrueQ", "[", 
       RowBox[{"continuityResidual", "==", "0"}], "]"}]}]}], "|>"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"allChecksPassed", "=", 
   RowBox[{"And", "@@", 
    RowBox[{"Values", "[", "checks", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"caseResults", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<case\>\"", "->", "\"\<flrw\>\""}], ",", 
     RowBox[{"\"\<checks\>\"", "->", "checks"}], ",", 
     RowBox[{"\"\<ricci\>\"", "->", 
      RowBox[{"ToString", "[", 
       RowBox[{"ricci", ",", "InputForm"}], "]"}]}], ",", 
     RowBox[{"\"\<scalar\>\"", "->", 
      RowBox[{"ToString", "[", 
       RowBox[{"scalar", ",", "InputForm"}], "]"}]}], ",", 
     RowBox[{"\"\<einstein\>\"", "->", 
      RowBox[{"ToString", "[", 
       RowBox[{"einstein", ",", "InputForm"}], "]"}]}], ",", 
     RowBox[{"\"\<densityResidual\>\"", "->", 
      RowBox[{"ToString", "[", 
       RowBox[{"densityResidual", ",", "InputForm"}], "]"}]}], ",", 
     RowBox[{"\"\<pressureResidual\>\"", "->", 
      RowBox[{"ToString", "[", 
       RowBox[{"pressureResidual", ",", "InputForm"}], "]"}]}], ",", 
     RowBox[{"\"\<continuityResidual\>\"", "->", 
      RowBox[{"ToString", "[", 
       RowBox[{"continuityResidual", ",", "InputForm"}], "]"}]}]}], "|>"}]}], 
  ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{"checks", ",", "allChecksPassed"}], "}"}]}], "Input",
 CellLabel->"In[27]:=",ExpressionUUID->"95ec5009-d234-544d-a830-860d98191319"],

