Cell[CellGroupData[{

Cell["\:89e3\:6790\:68c0\:67e5", "Section",ExpressionUUID->"1769b08d-a475-924b-86a9-87321134f542"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"checks", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<RicciVacuum\>\"", "->", 
      RowBox[{"TrueQ", "[", 
       RowBox[{"ricci", "==", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0", ",", 
          RowBox[{"{", 
           RowBox[{"4", ",", "4"}], "}"}]}], "]"}]}], "]"}]}], ",", 
     RowBox[{"\"\<ScalarZero\>\"", "->", 
      RowBox[{"TrueQ", "[", 
       RowBox[{"scalar", "==", "0"}], "]"}]}], ",", 
     RowBox[{"\"\<EinsteinVacuum\>\"", "->", 
      RowBox[{"TrueQ", "[", 
       RowBox[{"einstein", "==", 
        RowBox[{"ConstantArray", "[", 
         RowBox[{"0", ",", 
          RowBox[{"{", 
           RowBox[{"4", ",", "4"}], "}"}]}], "]"}]}], "]"}]}], ",", 
     RowBox[{"\"\<Kretschmann\>\"", "->", 
      RowBox[{"TrueQ", "[", 
       RowBox[{"Simplify", "[", 
        RowBox[{"kretschmann", "==", 
         RowBox[{"48", 
          RowBox[{
           RowBox[{"mass", "^", "2"}], "/", 
           RowBox[{
            RowBox[{"r", "[", "]"}], "^", "6"}]}]}]}], "]"}], "]"}]}], ",", 
     RowBox[{"\"\<EnergyConserved\>\"", "->", 
      RowBox[{"TrueQ", "[", 
       RowBox[{"energyResidual", "==", "0"}], "]"}]}], ",", 
     RowBox[{"\"\<AngularMomentumConserved\>\"", "->", 
      RowBox[{"TrueQ", "[", 
       RowBox[{"angularMomentumResidual", "==", "0"}], "]"}]}], ",", 
     RowBox[{"\"\<EquatorialPlane\>\"", "->", 
      RowBox[{"TrueQ", "[", 
       RowBox[{
        RowBox[{"equatorial", "[", 
         RowBox[{"[", "3", "]"}], "]"}], "==", "0"}], "]"}]}], ",", 
     RowBox[{"\"\<RadialGeodesic\>\"", "->", 
      RowBox[{"TrueQ", "[", 
       RowBox[{"Simplify", "[", 
        RowBox[{"radialFromGeodesic", "==", "radialEquation"}], "]"}], 
       "]"}]}], ",", 
     RowBox[{"\"\<ConstraintDerivative\>\"", "->", 
      RowBox[{"TrueQ", "[", 
       RowBox[{"constraintDerivativeResidual", "==", "0"}], "]"}]}]}], 
    "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"allChecksPassed", "=", 
   RowBox[{"And", "@@", 
    RowBox[{"Values", "[", "checks", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"caseResults", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<case\>\"", "->", "\"\<schwarzschild\>\""}], ",", 
     RowBox[{"\"\<checks\>\"", "->", "checks"}], ",", 
     RowBox[{"\"\<ricci\>\"", "->", 
      RowBox[{"ToString", "[", 
       RowBox[{"ricci", ",", "InputForm"}], "]"}]}], ",", 
     RowBox[{"\"\<scalar\>\"", "->", 
      RowBox[{"ToString", "[", 
       RowBox[{"scalar", ",", "InputForm"}], "]"}]}], ",", 
     RowBox[{"\"\<kretschmann\>\"", "->", 
      RowBox[{"ToString", "[", 
       RowBox[{"kretschmann", ",", "InputForm"}], "]"}]}], ",", 
     RowBox[{"\"\<geodesic\>\"", "->", 
      RowBox[{"ToString", "[", 
       RowBox[{"geodesic", ",", "InputForm"}], "]"}]}], ",", 
     RowBox[{"\"\<radialConstraint\>\"", "->", 
      RowBox[{"ToString", "[", 
       RowBox[{"radialConstraint", ",", "InputForm"}], "]"}]}], ",", 
     RowBox[{"\"\<radialEquation\>\"", "->", 
      RowBox[{"ToString", "[", 
       RowBox[{"radialEquation", ",", "InputForm"}], "]"}]}]}], "|>"}]}], 
  ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{"checks", ",", "allChecksPassed"}], "}"}]}], "Input",
 CellLabel->"In[33]:=",ExpressionUUID->"04c16ae8-3976-464b-8bdd-919e29b379b4"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"RicciVacuum\"\>", "\[Rule]", "True"}], ",", 
     RowBox[{"\<\"ScalarZero\"\>", "\[Rule]", "True"}], ",", 
     RowBox[{"\<\"EinsteinVacuum\"\>", "\[Rule]", "True"}], ",", 
     RowBox[{"\<\"Kretschmann\"\>", "\[Rule]", "True"}], ",", 
     RowBox[{"\<\"EnergyConserved\"\>", "\[Rule]", "True"}], ",", 
     RowBox[{"\<\"AngularMomentumConserved\"\>", "\[Rule]", "True"}], ",", 
     RowBox[{"\<\"EquatorialPlane\"\>", "\[Rule]", "True"}], ",", 
     RowBox[{"\<\"RadialGeodesic\"\>", "\[Rule]", "True"}], ",", 
     RowBox[{"\<\"ConstraintDerivative\"\>", "\[Rule]", "True"}]}], 
    "\[RightAssociation]"}], ",", "True"}], "}"}]], "Output",
 CellChangeTimes->{4.002341754541071*^9},
 CellLabel->"Out[36]=",ExpressionUUID->"9f9d338b-32d7-a545-9652-8803750b0651"]
}, Open  ]]
