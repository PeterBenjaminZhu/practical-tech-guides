Cell["\:5b9e\:9645 curvature \:548c matter tensor", "Section",ExpressionUUID->"edee138b-04bb-1a43-a232-46fbe2976dc4"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ricci", "=", 
   RowBox[{"ToValues", "[", 
    RowBox[{"ComponentArray", "[", 
     RowBox[{
      RowBox[{"ToBasis", "[", "ch", "]"}], "[", 
      RowBox[{"RicciCD", "[", 
       RowBox[{
        RowBox[{"-", "a"}], ",", 
        RowBox[{"-", "b"}]}], "]"}], "]"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"scalar", "=", 
   RowBox[{"ToValues", "[", 
    RowBox[{"RicciScalarCD", "[", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"einstein", "=", 
   RowBox[{"ToValues", "[", 
    RowBox[{"ComponentArray", "[", 
     RowBox[{
      RowBox[{"ToBasis", "[", "ch", "]"}], "[", 
      RowBox[{"EinsteinCD", "[", 
       RowBox[{
        RowBox[{"-", "a"}], ",", 
        RowBox[{"-", "b"}]}], "]"}], "]"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"fourVelocity", "=", 
   RowBox[{"{", 
    RowBox[{"1", ",", "0", ",", "0", ",", "0"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"loweredVelocity", "=", 
   RowBox[{"metricMatrix", ".", "fourVelocity"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"matter", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"rho", "[", 
        RowBox[{"t", "[", "]"}], "]"}], "+", 
       RowBox[{"pressure", "[", 
        RowBox[{"t", "[", "]"}], "]"}]}], ")"}], " ", 
     RowBox[{"Outer", "[", 
      RowBox[{"Times", ",", "loweredVelocity", ",", "loweredVelocity"}], 
      "]"}]}], "+", 
    RowBox[{
     RowBox[{"pressure", "[", 
      RowBox[{"t", "[", "]"}], "]"}], " ", "metricMatrix"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"fieldEquations", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{"einstein", "+", 
     RowBox[{"lambda", " ", "metricMatrix"}], "-", 
     RowBox[{"8", "Pi", " ", "GN", " ", "matter"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{"ricci", ",", "scalar", ",", "einstein", ",", "matter"}], 
  "}"}]}], "Input",
 CellLabel->"In[11]:=",ExpressionUUID->"b4157dbb-f639-0647-810d-25b05936465c"],

