Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"DefManifold", "[", 
   RowBox[{"M", ",", "4", ",", 
    RowBox[{"{", 
     RowBox[{"a", ",", "b", ",", "c", ",", "d", ",", "e", ",", "f"}], "}"}]}],
    "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"DefChart", "[", 
   RowBox[{"ch", ",", "M", ",", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2", ",", "3", ",", "4"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"t", "[", "]"}], ",", 
      RowBox[{"r", "[", "]"}], ",", 
      RowBox[{"theta", "[", "]"}], ",", 
      RowBox[{"phi", "[", "]"}]}], "}"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"DefConstantSymbol", "[", "radius", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"DefMetric", "[", 
   RowBox[{
    RowBox[{"-", "1"}], ",", 
    RowBox[{"g", "[", 
     RowBox[{
      RowBox[{"-", "a"}], ",", 
      RowBox[{"-", "b"}]}], "]"}], ",", "CD", ",", 
    RowBox[{"{", 
     RowBox[{"\"\<;\>\"", ",", "\"\<D\>\""}], "}"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"$Assumptions", "=", 
   RowBox[{
    RowBox[{"radius", ">", "0"}], " ", "&&", " ", 
    RowBox[{
     RowBox[{"r", "[", "]"}], ">", "0"}], " ", "&&", " ", 
    RowBox[{"0", "<", 
     RowBox[{"theta", "[", "]"}], "<", "Pi"}], " ", "&&", " ", 
    RowBox[{"Element", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"t", "[", "]"}], ",", 
        RowBox[{"phi", "[", "]"}]}], "}"}], ",", "Reals"}], "]"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"metricMatrix", "=", 
   RowBox[{"DiagonalMatrix", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{
          RowBox[{
           RowBox[{"r", "[", "]"}], "^", "2"}], "/", 
          RowBox[{"radius", "^", "2"}]}]}], ")"}]}], ",", 
      RowBox[{"1", "/", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{
          RowBox[{
           RowBox[{"r", "[", "]"}], "^", "2"}], "/", 
          RowBox[{"radius", "^", "2"}]}]}], ")"}]}], ",", 
      RowBox[{
       RowBox[{"r", "[", "]"}], "^", "2"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"r", "[", "]"}], "^", "2"}], " ", 
       RowBox[{
        RowBox[{"Sin", "[", 
         RowBox[{"theta", "[", "]"}], "]"}], "^", "2"}]}]}], "}"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"MetricInBasis", "[", 
   RowBox[{"g", ",", 
    RowBox[{"-", "ch"}], ",", "metricMatrix"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"MetricCompute", "[", 
   RowBox[{"g", ",", "ch", ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<Riemann\>\"", "[", 
       RowBox[{
        RowBox[{"-", "1"}], ",", 
        RowBox[{"-", "1"}], ",", 
        RowBox[{"-", "1"}], ",", 
        RowBox[{"-", "1"}]}], "]"}], ",", 
      RowBox[{"\"\<Ricci\>\"", "[", 
       RowBox[{
        RowBox[{"-", "1"}], ",", 
        RowBox[{"-", "1"}]}], "]"}], ",", 
      RowBox[{"\"\<RicciScalar\>\"", "[", "]"}], ",", 
      RowBox[{"\"\<Einstein\>\"", "[", 
       RowBox[{
        RowBox[{"-", "1"}], ",", 
        RowBox[{"-", "1"}]}], "]"}], ",", 
      RowBox[{"\"\<Kretschmann\>\"", "[", "]"}]}], "}"}], ",", 
    RowBox[{"CVSimplify", "->", "Simplify"}]}], "]"}], ";"}]}], "Input",
 CellLabel->"In[2]:=",ExpressionUUID->"a703e7ee-b1be-714e-9b47-e86d23256050"],

