Cell["FLRW\:ff1aperfect fluid\:3001Lambda \:4e0e Friedmann equations", "Title",ExpressionUUID->"9604a2f3-8328-2941-9db1-0d8df98d22b8"],

Cell[CellGroupData[{

Cell["\:95ee\:9898\:4e0e\:524d\:63d0", "Section",ExpressionUUID->"57785da9-71fc-b743-bd96-6f7a5d036968"],

Cell["\<\
\:56db\:7ef4 Friedmann-Lemaitre-Robertson-Walker metric\:ff0csignature \
(-,+,+,+)\:ff0cc=1\:3002\:5750\:6807 \
(t,r,theta,phi)\:ff0caScale[t]>0\:ff0cr>0\:ff0c1-k \
r^2>0\:ff0c0<theta<Pi\:3002r\:3001\:89d2\:5ea6\:548ck\:65e0\:91cf\:7eb2\:ff0c\
aScale\:5177\:6709\:957f\:5ea6\:91cf\:7eb2\:ff1bt\:5177\:6709\:957f\:5ea6\
\:91cf\:7eb2\:3002k \:4fdd\:7559\:4e00\:822c\:5e38\:6570\:3002perfect fluid \
\:968f comoving observer \:8fd0\:52a8\:ff0c\:56db\:901f\:5ea6 u^mu=(1,0,0,0)\
\:ff0c\:80fd\:91cf\:5bc6\:5ea6 rho[t] \:4e0e\:538b\:529b \
pressure[t]\:3002Einstein equation \:4e3a G_mu_nu+lambda g_mu_nu=8 Pi GN \
T_mu_nu\:3002\
\>", "Text",ExpressionUUID->"bd73de76-9b6e-9f4f-ab0c-10ad4b0c8931"],

