Cell["\:89e3\:6790\:68c0\:67e5", "Section",ExpressionUUID->"d7219e30-7b2a-c34a-aa17-90bda460659b"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"expectedRiemann", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"metricMatrix", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "k"}], "]"}], "]"}], " ", 
          RowBox[{"metricMatrix", "[", 
           RowBox[{"[", 
            RowBox[{"j", ",", "l"}], "]"}], "]"}]}], "-", 
         RowBox[{
          RowBox[{"metricMatrix", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "l"}], "]"}], "]"}], " ", 
          RowBox[{"metricMatrix", "[", 
           RowBox[{"[", 
            RowBox[{"j", ",", "k"}], "]"}], "]"}]}]}], ")"}]}], "/", 
      RowBox[{"radius", "^", "2"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "5"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "5"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "5"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"l", ",", "5"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"checks", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<Riemann\>\"", "->", 
      RowBox[{"TrueQ", "[", 
       RowBox[{"Simplify", "[", 
        RowBox[{"curvature", "==", "expectedRiemann"}], "]"}], "]"}]}], ",", 
     RowBox[{"\"\<Ricci\>\"", "->", 
      RowBox[{"TrueQ", "[", 
       RowBox[{"Simplify", "[", 
        RowBox[{"ricci", "==", 
         RowBox[{
          RowBox[{"-", "4"}], 
          RowBox[{"metricMatrix", "/", 
           RowBox[{"radius", "^", "2"}]}]}]}], "]"}], "]"}]}], ",", 
     RowBox[{"\"\<Scalar\>\"", "->", 
      RowBox[{"TrueQ", "[", 
       RowBox[{"Simplify", "[", 
        RowBox[{"scalar", "==", 
         RowBox[{
          RowBox[{"-", "20"}], "/", 
          RowBox[{"radius", "^", "2"}]}]}], "]"}], "]"}]}], ",", 
     RowBox[{"\"\<Kretschmann\>\"", "->", 
      RowBox[{"TrueQ", "[", 
       RowBox[{"Simplify", "[", 
        RowBox[{"kretschmann", "==", 
         RowBox[{"40", "/", 
          RowBox[{"radius", "^", "4"}]}]}], "]"}], "]"}]}], ",", 
     RowBox[{"\"\<VacuumLambda\>\"", "->", 
      RowBox[{"TrueQ", "[", 
       RowBox[{"Simplify", "[", 
        RowBox[{
         RowBox[{"einstein", "-", 
          RowBox[{"6", 
           RowBox[{"metricMatrix", "/", 
            RowBox[{"radius", "^", "2"}]}]}]}], "==", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{"0", ",", 
           RowBox[{"{", 
            RowBox[{"5", ",", "5"}], "}"}]}], "]"}]}], "]"}], "]"}]}]}], 
    "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"allChecksPassed", "=", 
   RowBox[{"And", "@@", 
    RowBox[{"Values", "[", "checks", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"caseResults", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<case\>\"", "->", "\"\<ads5-poincare\>\""}], ",", 
     RowBox[{"\"\<checks\>\"", "->", "checks"}], ",", 
     RowBox[{"\"\<ricci\>\"", "->", 
      RowBox[{"ToString", "[", 
       RowBox[{"ricci", ",", "InputForm"}], "]"}]}], ",", 
     RowBox[{"\"\<scalar\>\"", "->", 
      RowBox[{"ToString", "[", 
       RowBox[{"scalar", ",", "InputForm"}], "]"}]}], ",", 
     RowBox[{"\"\<kretschmann\>\"", "->", 
      RowBox[{"ToString", "[", 
       RowBox[{"kretschmann", ",", "InputForm"}], "]"}]}]}], "|>"}]}], 
  ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{"checks", ",", "allChecksPassed"}], "}"}]}], "Input",
 CellLabel->"In[16]:=",ExpressionUUID->"40e720bf-9b4e-f843-a7a2-151a889cfa6f"],

