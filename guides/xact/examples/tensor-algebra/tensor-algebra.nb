Cell[CellGroupData[{

Cell["\:5b9e\:9645\:8ba1\:7b97", "Section",ExpressionUUID->"71f12427-24ca-c24e-8a8c-e1f19eef70ac"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"contraction", "=", 
   RowBox[{"ToCanonical", "[", 
    RowBox[{
     RowBox[{"symmetric", "[", 
      RowBox[{
       RowBox[{"-", "a"}], ",", 
       RowBox[{"-", "b"}]}], "]"}], " ", 
     RowBox[{"antisymmetric", "[", 
      RowBox[{"a", ",", "b"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"metricTrace", "=", 
   RowBox[{"ContractMetric", "[", 
    RowBox[{
     RowBox[{"g", "[", 
      RowBox[{"a", ",", "b"}], "]"}], " ", 
     RowBox[{"g", "[", 
      RowBox[{
       RowBox[{"-", "a"}], ",", 
       RowBox[{"-", "b"}]}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"raised", "=", 
   RowBox[{"ContractMetric", "[", 
    RowBox[{
     RowBox[{"g", "[", 
      RowBox[{"a", ",", "b"}], "]"}], " ", 
     RowBox[{"velocity", "[", 
      RowBox[{"-", "b"}], "]"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"renamedDifference", "=", 
   RowBox[{"ToCanonical", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"velocity", "[", "a", "]"}], " ", 
      RowBox[{"velocity", "[", 
       RowBox[{"-", "a"}], "]"}]}], "-", 
     RowBox[{
      RowBox[{"velocity", "[", "b", "]"}], " ", 
      RowBox[{"velocity", "[", 
       RowBox[{"-", "b"}], "]"}]}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
  "contraction", ",", "metricTrace", ",", "raised", ",", 
   "renamedDifference"}], "}"}]}], "Input",
 CellLabel->"In[7]:=",ExpressionUUID->"26677e22-dff7-2545-b06a-60adadd026f0"],

