 RowBox[{
  RowBox[{"checks", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<SymmetricAntisymmetric\>\"", "->", 
      RowBox[{"TrueQ", "[", 
       RowBox[{"contraction", "==", "0"}], "]"}]}], ",", 
     RowBox[{"\"\<TraceDimension\>\"", "->", 
      RowBox[{"TrueQ", "[", 
       RowBox[{"metricTrace", "==", "4"}], "]"}]}], ",", 
