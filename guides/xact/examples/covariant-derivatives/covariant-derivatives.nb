\>", "Text",ExpressionUUID->"a5cc655e-bb24-1e43-9bd7-e50747135803"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"checks", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<MetricCompatibility\>\"", "->", 
      RowBox[{"TrueQ", "[", 
       RowBox[{"metricDerivative", "==", "0"}], "]"}]}], ",", 
     RowBox[{"\"\<VectorCommutator\>\"", "->", 
      RowBox[{"TrueQ", "[", 
       RowBox[{
        RowBox[{"ToCanonical", "[", 
         RowBox[{"vectorCommutator", "+", 
          RowBox[{
           RowBox[{"RiemannCD", "[", 
            RowBox[{
             RowBox[{"-", "a"}], ",", 
             RowBox[{"-", "b"}], ",", 
             RowBox[{"-", "d"}], ",", "c"}], "]"}], " ", 
           RowBox[{"vector", "[", "d", "]"}]}]}], "]"}], "==", "0"}], "]"}]}],
      ",", 
     RowBox[{"\"\<CovectorCommutator\>\"", "->", 
      RowBox[{"TrueQ", "[", 
       RowBox[{
        RowBox[{"ToCanonical", "[", 
         RowBox[{"covectorCommutator", "-", 
          RowBox[{
           RowBox[{"RiemannCD", "[", 
            RowBox[{
             RowBox[{"-", "a"}], ",", 
             RowBox[{"-", "b"}], ",", 
             RowBox[{"-", "c"}], ",", "d"}], "]"}], " ", 
           RowBox[{"omega", "[", 
            RowBox[{"-", "d"}], "]"}]}]}], "]"}], "==", "0"}], "]"}]}]}], 
    "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"allChecksPassed", "=", 
   RowBox[{"And", "@@", 
    RowBox[{"Values", "[", "checks", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"caseResults", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<case\>\"", "->", "\"\<covariant-derivatives\>\""}], ",", 
     RowBox[{"\"\<checks\>\"", "->", "checks"}], ",", 
     RowBox[{"\"\<vectorCommutator\>\"", "->", 
      RowBox[{"ToString", "[", 
       RowBox[{"vectorCommutator", ",", "InputForm"}], "]"}]}], ",", 
     RowBox[{"\"\<covectorCommutator\>\"", "->", 
      RowBox[{"ToString", "[", 
       RowBox[{"covectorCommutator", ",", "InputForm"}], "]"}]}]}], "|>"}]}], 
  ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{"checks", ",", "allChecksPassed"}], "}"}]}], "Input",
 CellLabel->"In[10]:=",ExpressionUUID->"8be72239-4ff4-164a-9d49-448c2ffb0386"],

