Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"DefConstantSymbol", "[", "dimension", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"DefConstantSymbol", "[", "curvature", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"DefManifold", "[", 
   RowBox[{"M", ",", "dimension", ",", 
    RowBox[{"{", 
     RowBox[{
     "a", ",", "b", ",", "c", ",", "d", ",", "e", ",", "f", ",", "h", ",", 
      "i"}], "}"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"DefMetric", "[", 
   RowBox[{
    RowBox[{"-", "1"}], ",", 
    RowBox[{"g", "[", 
     RowBox[{
      RowBox[{"-", "a"}], ",", 
      RowBox[{"-", "b"}]}], "]"}], ",", "CD", ",", 
    RowBox[{"{", 
     RowBox[{"\"\<;\>\"", ",", "\"\<D\>\""}], "}"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"$Assumptions", "=", 
   RowBox[{
    RowBox[{"Element", "[", 
     RowBox[{"dimension", ",", "Integers"}], "]"}], " ", "&&", " ", 
    RowBox[{"dimension", ">=", "2"}], " ", "&&", " ", 
    RowBox[{"Element", "[", 
     RowBox[{"curvature", ",", "Reals"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"constantCurvatureRules", "=", 
   RowBox[{"MakeRule", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"RiemannCD", "[", 
        RowBox[{
         RowBox[{"-", "a"}], ",", 
         RowBox[{"-", "b"}], ",", 
         RowBox[{"-", "c"}], ",", 
         RowBox[{"-", "d"}]}], "]"}], ",", 
       RowBox[{"curvature", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"g", "[", 
            RowBox[{
             RowBox[{"-", "a"}], ",", 
             RowBox[{"-", "c"}]}], "]"}], " ", 
           RowBox[{"g", "[", 
            RowBox[{
             RowBox[{"-", "b"}], ",", 
             RowBox[{"-", "d"}]}], "]"}]}], "-", 
          RowBox[{
           RowBox[{"g", "[", 
            RowBox[{
             RowBox[{"-", "a"}], ",", 
             RowBox[{"-", "d"}]}], "]"}], " ", 
           RowBox[{"g", "[", 
            RowBox[{
             RowBox[{"-", "b"}], ",", 
             RowBox[{"-", "c"}]}], "]"}]}]}], ")"}]}]}], "}"}], ",", 
     RowBox[{"MetricOn", "->", "All"}], ",", 
     RowBox[{"ContractMetrics", "->", "True"}]}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[2]:=",ExpressionUUID->"6b4dd888-f4b4-f948-a26e-148261a6341e"],

