Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ricci", "=", 
   RowBox[{"ToValues", "[", 
    RowBox[{"ComponentArray", "[", 
     RowBox[{
      RowBox[{"ToBasis", "[", "ch", "]"}], "[", 
      RowBox[{"RicciCD", "[", 
       RowBox[{
        RowBox[{"-", "a"}], ",", 
        RowBox[{"-", "b"}]}], "]"}], "]"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"scalar", "=", 
   RowBox[{"ToValues", "[", 
    RowBox[{"RicciScalarCD", "[", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"riemannSample", "=", 
   RowBox[{"ToValues", "[", 
    RowBox[{"RiemannCD", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", 
        RowBox[{"-", "ch"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", 
        RowBox[{"-", "ch"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", 
        RowBox[{"-", "ch"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "ch"}], "}"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{"ricci", ",", "scalar", ",", "riemannSample"}], "}"}]}], "Input",
 CellLabel->"In[10]:=",ExpressionUUID->"c96e3d83-6e68-cf49-83f8-96f15a7c26c3"],

