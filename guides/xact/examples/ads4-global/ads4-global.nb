Cell[CellGroupData[{

Cell["\:89e3\:6790\:68c0\:67e5", "Section",ExpressionUUID->"64178ad8-7d17-6f4c-b0f8-23dc4af21dab"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"expectedRiemann", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"metricMatrix", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "k"}], "]"}], "]"}], " ", 
          RowBox[{"metricMatrix", "[", 
           RowBox[{"[", 
            RowBox[{"j", ",", "l"}], "]"}], "]"}]}], "-", 
         RowBox[{
          RowBox[{"metricMatrix", "[", 
           RowBox[{"[", 
            RowBox[{"i", ",", "l"}], "]"}], "]"}], " ", 
          RowBox[{"metricMatrix", "[", 
           RowBox[{"[", 
            RowBox[{"j", ",", "k"}], "]"}], "]"}]}]}], ")"}]}], "/", 
      RowBox[{"radius", "^", "2"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "4"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "4"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "4"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"l", ",", "4"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"checks", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<Riemann\>\"", "->", 
      RowBox[{"TrueQ", "[", 
       RowBox[{"Simplify", "[", 
        RowBox[{"curvature", "==", "expectedRiemann"}], "]"}], "]"}]}], ",", 
     RowBox[{"\"\<Ricci\>\"", "->", 
      RowBox[{"TrueQ", "[", 
       RowBox[{"Simplify", "[", 
        RowBox[{"ricci", "==", 
         RowBox[{
          RowBox[{"-", "3"}], 
          RowBox[{"metricMatrix", "/", 
           RowBox[{"radius", "^", "2"}]}]}]}], "]"}], "]"}]}], ",", 
     RowBox[{"\"\<Scalar\>\"", "->", 
      RowBox[{"TrueQ", "[", 
       RowBox[{"Simplify", "[", 
        RowBox[{"scalar", "==", 
         RowBox[{
          RowBox[{"-", "12"}], "/", 
          RowBox[{"radius", "^", "2"}]}]}], "]"}], "]"}]}], ",", 
     RowBox[{"\"\<Kretschmann\>\"", "->", 
      RowBox[{"TrueQ", "[", 
       RowBox[{"Simplify", "[", 
        RowBox[{"kretschmann", "==", 
         RowBox[{"24", "/", 
          RowBox[{"radius", "^", "4"}]}]}], "]"}], "]"}]}], ",", 
     RowBox[{"\"\<VacuumLambda\>\"", "->", 
      RowBox[{"TrueQ", "[", 
       RowBox[{"Simplify", "[", 
        RowBox[{
         RowBox[{"einstein", "-", 
          RowBox[{"3", 
           RowBox[{"metricMatrix", "/", 
            RowBox[{"radius", "^", "2"}]}]}]}], "==", 
         RowBox[{"ConstantArray", "[", 
          RowBox[{"0", ",", 
           RowBox[{"{", 
            RowBox[{"4", ",", "4"}], "}"}]}], "]"}]}], "]"}], "]"}]}]}], 
    "|>"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"allChecksPassed", "=", 
   RowBox[{"And", "@@", 
    RowBox[{"Values", "[", "checks", "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"caseResults", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"\"\<case\>\"", "->", "\"\<ads4-global\>\""}], ",", 
     RowBox[{"\"\<checks\>\"", "->", "checks"}], ",", 
     RowBox[{"\"\<ricci\>\"", "->", 
      RowBox[{"ToString", "[", 
       RowBox[{"ricci", ",", "InputForm"}], "]"}]}], ",", 
     RowBox[{"\"\<scalar\>\"", "->", 
      RowBox[{"ToString", "[", 
       RowBox[{"scalar", ",", "InputForm"}], "]"}]}], ",", 
     RowBox[{"\"\<kretschmann\>\"", "->", 
      RowBox[{"ToString", "[", 
       RowBox[{"kretschmann", ",", "InputForm"}], "]"}]}]}], "|>"}]}], 
  ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{"checks", ",", "allChecksPassed"}], "}"}]}], "Input",
 CellLabel->"In[16]:=",ExpressionUUID->"fa430a23-2294-724c-933c-b63441c000c7"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\[LeftAssociation]", 
    RowBox[{
     RowBox[{"\<\"Riemann\"\>", "\[Rule]", "True"}], ",", 
     RowBox[{"\<\"Ricci\"\>", "\[Rule]", "True"}], ",", 
     RowBox[{"\<\"Scalar\"\>", "\[Rule]", "True"}], ",", 
     RowBox[{"\<\"Kretschmann\"\>", "\[Rule]", "True"}], ",", 
     RowBox[{"\<\"VacuumLambda\"\>", "\[Rule]", "True"}]}], 
    "\[RightAssociation]"}], ",", "True"}], "}"}]], "Output",
