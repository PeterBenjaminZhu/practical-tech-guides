Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"DefManifold", "[", 
   RowBox[{"M", ",", "4", ",", 
    RowBox[{"{", 
     RowBox[{"a", ",", "b", ",", "c", ",", "d", ",", "e", ",", "f"}], "}"}]}],
    "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"DefChart", "[", 
   RowBox[{"ch", ",", "M", ",", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2", ",", "3", ",", "4"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"t", "[", "]"}], ",", 
      RowBox[{"r", "[", "]"}], ",", 
      RowBox[{"theta", "[", "]"}], ",", 
      RowBox[{"phi", "[", "]"}]}], "}"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"DefConstantSymbol", " ", "/@", " ", 
   RowBox[{"{", 
    RowBox[{"k", ",", "lambda", ",", "GN"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"DefScalarFunction", " ", "/@", " ", 
   RowBox[{"{", 
    RowBox[{"aScale", ",", "rho", ",", "pressure"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"DefMetric", "[", 
   RowBox[{
    RowBox[{"-", "1"}], ",", 
    RowBox[{"g", "[", 
     RowBox[{
      RowBox[{"-", "a"}], ",", 
      RowBox[{"-", "b"}]}], "]"}], ",", "CD", ",", 
    RowBox[{"{", 
     RowBox[{"\"\<;\>\"", ",", "\"\<D\>\""}], "}"}]}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"$Assumptions", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"aScale", "[", 
      RowBox[{"t", "[", "]"}], "]"}], ">", "0"}], " ", "&&", " ", 
    RowBox[{
     RowBox[{"r", "[", "]"}], ">", "0"}], " ", "&&", " ", 
    RowBox[{
     RowBox[{"1", "-", 
      RowBox[{"k", " ", 
       RowBox[{
        RowBox[{"r", "[", "]"}], "^", "2"}]}]}], ">", "0"}], " ", "&&", " ", 
    RowBox[{"0", "<", 
     RowBox[{"theta", "[", "]"}], "<", "Pi"}], " ", "&&", " ", 
    RowBox[{"GN", ">", "0"}], " ", "&&", " ", 
    RowBox[{"Element", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"k", ",", "lambda", ",", 
        RowBox[{"t", "[", "]"}], ",", 
        RowBox[{"phi", "[", "]"}]}], "}"}], ",", "Reals"}], "]"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"metricMatrix", "=", 
   RowBox[{"DiagonalMatrix", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"-", "1"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"aScale", "[", 
         RowBox[{"t", "[", "]"}], "]"}], "^", "2"}], "/", 
       RowBox[{"(", 
        RowBox[{"1", "-", 
         RowBox[{"k", " ", 
          RowBox[{
           RowBox[{"r", "[", "]"}], "^", "2"}]}]}], ")"}]}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"aScale", "[", 
         RowBox[{"t", "[", "]"}], "]"}], "^", "2"}], " ", 
       RowBox[{
        RowBox[{"r", "[", "]"}], "^", "2"}]}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"aScale", "[", 
         RowBox[{"t", "[", "]"}], "]"}], "^", "2"}], " ", 
       RowBox[{
        RowBox[{"r", "[", "]"}], "^", "2"}], " ", 
       RowBox[{
        RowBox[{"Sin", "[", 
         RowBox[{"theta", "[", "]"}], "]"}], "^", "2"}]}]}], "}"}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"MetricInBasis", "[", 
   RowBox[{"g", ",", 
    RowBox[{"-", "ch"}], ",", "metricMatrix"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"MetricCompute", "[", 
   RowBox[{"g", ",", "ch", ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\"\<Ricci\>\"", "[", 
       RowBox[{
        RowBox[{"-", "1"}], ",", 
        RowBox[{"-", "1"}]}], "]"}], ",", 
      RowBox[{"\"\<RicciScalar\>\"", "[", "]"}], ",", 
      RowBox[{"\"\<Einstein\>\"", "[", 
       RowBox[{
        RowBox[{"-", "1"}], ",", 
        RowBox[{"-", "1"}]}], "]"}]}], "}"}], ",", 
    RowBox[{"CVSimplify", "->", "Simplify"}]}], "]"}], ";"}]}], "Input",
 CellLabel->"In[2]:=",ExpressionUUID->"f0629f40-0a67-9246-88c9-ee065f05725b"],

